        // Syntetyczny dźwięk kopnięcia listwy (PYK-BZZZT)
        function playPowerCutSound() {
            const ctx = ensureAudioCtx();
            const now = ctx.currentTime;
            // Kliknięcie przycisku listwy
            const clickOsc = ctx.createOscillator();
            const clickG = ctx.createGain();
            clickOsc.type = 'square';
            clickOsc.frequency.setValueAtTime(900, now);
            clickOsc.frequency.exponentialRampToValueAtTime(60, now + 0.04);
            clickG.gain.setValueAtTime(0.14, now);
            clickG.gain.exponentialRampToValueAtTime(0.001, now + 0.05);
            clickOsc.connect(clickG);
            clickG.connect(ctx.destination);
            clickOsc.start(now);
            clickOsc.stop(now + 0.06);

            // Opadający pisk cewek CRT
            const crtOsc = ctx.createOscillator();
            const crtG = ctx.createGain();
            crtOsc.type = 'sine';
            crtOsc.frequency.setValueAtTime(2200, now + 0.03);
            crtOsc.frequency.exponentialRampToValueAtTime(110, now + 0.45);
            crtG.gain.setValueAtTime(0.06, now + 0.03);
            crtG.gain.exponentialRampToValueAtTime(0.001, now + 0.48);
            crtOsc.connect(crtG);
            crtG.connect(ctx.destination);
            crtOsc.start(now + 0.03);
            crtOsc.stop(now + 0.5);
