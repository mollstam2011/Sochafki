            let targetMusicVol = 0;
            let targetNoiseVol = 0;
            let targetHumVol = 0;
            let targetFilterFreq = 1200;
            let targetBassBoost = 0;
            let targetDistort = 10;

            if (v < 25) {
                statusMsg = '❌ Brak styku (tylko brum 50Hz)';
                textColor = 'text-red-500';
