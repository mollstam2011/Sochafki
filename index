        // Ryk wentylatora odrzutowca (CS 1.6 / GTA 4)
        function startJetFanSound() {
            stopJetFanSound();
            const ctx = ensureAudioCtx();
            const now = ctx.currentTime;

            const bufferSize = ctx.sampleRate * 2;
            const buf = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
            const data = buf.getChannelData(0);
            for (let i = 0; i < bufferSize; i++) {
                data[i] = Math.random() * 2 - 1;
            }

            const noise = ctx.createBufferSource();
            noise.buffer = buf;
            noise.loop = true;

            const bp = ctx.createBiquadFilter();
            bp.type = 'bandpass';
            bp.frequency.setValueAtTime(260, now);
            bp.frequency.exponentialRampToValueAtTime(880, now + 2.2);
            bp.Q.value = 1.4;

            const whine = ctx.createOscillator();
            whine.type = 'sawtooth';
            whine.frequency.setValueAtTime(110, now);
            whine.frequency.exponentialRampToValueAtTime(340, now + 2.2);

            const whineG = ctx.createGain();
            whineG.gain.value = 0.025;

            const masterG = ctx.createGain();
            masterG.gain.setValueAtTime(0.01, now);
            masterG.gain.linearRampToValueAtTime(0.11, now + 1.5);

            noise.connect(bp);
            bp.connect(masterG);
            whine.connect(whineG);
            whineG.connect(masterG);
            masterG.connect(ctx.destination);

            noise.start(now);
            whine.start(now);

            pcFanNodes = { noise, whine, masterG };
        }

        function stopJetFanSound() {
            if (!pcFanNodes || !audioCtx) return;
            try {
                const t = audioCtx.currentTime;
                pcFanNodes.masterG.gain.setTargetAtTime(0.0001, t, 0.05);
                pcFanNodes.noise.stop(t + 0.15);
                pcFanNodes.whine.stop(t + 0.15);
            } catch (e) {}
            pcFanNodes = null;
        }

