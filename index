        }
        window.addEventListener('resize', resizeConfettiCanvas);
        resizeConfettiCanvas();

        function launchSochafkiConfetti() {
            confettiParticles = [];
            const texts = ['SOCHAFKI', '144p', '🎧', '4,99 ZŁ', 'TRZASK', '🕊️', 'STEINBACH', '3 FPS'];
            const colors = ['#00ffff', '#ffffff', '#ff3b00', '#facc15'];

            for (let i = 0; i < 95; i++) {
                confettiParticles.push({
                    x: Math.random() * confettiCanvas.width,
                    y: -20 - Math.random() * 250,
                    vx: (Math.random() - 0.5) * 6,
                    vy: 3 + Math.random() * 5,
                    rot: Math.random() * Math.PI * 2,
                    vRot: (Math.random() - 0.5) * 0.15,
                    isText: Math.random() > 0.35,
                    text: texts[Math.floor(Math.random() * texts.length)],
                    color: colors[Math.floor(Math.random() * colors.length)],
                    size: 12 + Math.random() * 14
                });
            }

            if (confettiAnimId) cancelAnimationFrame(confettiAnimId);
            animateConfetti();
        }

        function animateConfetti() {
            confettiCtx.clearRect(0, 0, confettiCanvas.width, confettiCanvas.height);
            let activeCount = 0;

            confettiParticles.forEach(p => {
                p.x += p.vx;
                p.y += p.vy;
                p.rot += p.vRot;
                p.vy += 0.08;

                if (p.y < confettiCanvas.height + 50) {
                    activeCount++;
                    confettiCtx.save();
                    confettiCtx.translate(p.x, p.y);
                    confettiCtx.rotate(p.rot);

                    if (p.isText) {
                        confettiCtx.font = `900 ${Math.floor(p.size)}px Inter, sans-serif`;
                        confettiCtx.fillStyle = p.color;
                        confettiCtx.strokeStyle = '#000000';
                        confettiCtx.lineWidth = 3;
                        confettiCtx.strokeText(p.text, 0, 0);
                        confettiCtx.fillText(p.text, 0, 0);
                    } else {
                        confettiCtx.fillStyle = p.color;
                        confettiCtx.fillRect(-p.size / 2, -p.size / 4, p.size, p.size / 2);
                    }
                    confettiCtx.restore();
                }
            });

            if (activeCount > 0) {
                confettiAnimId = requestAnimationFrame(animateConfetti);
            } else {
                confettiCtx.clearRect(0, 0, confettiCanvas.width, confettiCanvas.height);
            }
        }

        /* =====================================================================
           INICJALIZACJA PO ZAŁADOWANIU STRONY
           ===================================================================== */
        window.addEventListener('DOMContentLoaded', () => {
            applyDeepFry(deepFrySlider.value);
            updateCablePhysics(cableSlider.value);
            updateTangleUI();
        });
    </script>
</body>
