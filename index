                clearInterval(vuInterval);

                if (cableAudioInitialized && audioCtx) {
                    const t = audioCtx.currentTime;
                    musicGain.gain.setTargetAtTime(0, t, 0.02);
                    noiseGain.gain.setTargetAtTime(0, t, 0.02);
                    humGain.gain.setTargetAtTime(0, t, 0.02);
