        function makeDistortionCurve(amount) {
            const k = amount;
            const n_samples = 44100;
            const curve = new Float32Array(n_samples);
            const deg = Math.PI / 180;
            for (let i = 0; i < n_samples; ++i) {
                const x = (i * 2) / n_samples - 1;
                curve[i] = ((3 + k) * x * 20 * deg) / (Math.PI + k * Math.abs(x));
            }
            return curve;
        }

        function initCableAudio() {
            const ctx = ensureAudioCtx();
            if (cableAudioInitialized) return;
            cableAudioInitialized = true;

            musicGain = ctx.createGain();
            musicGain.gain.value = 0;

            filterNode = ctx.createBiquadFilter();
            filterNode.type = 'lowpass';
            filterNode.frequency.value = 1800;

            bassBoostNode = ctx.createBiquadFilter();
            bassBoostNode.type = 'lowshelf';
            bassBoostNode.frequency.value = 140;
            bassBoostNode.gain.value = 0;

            distortionNode = ctx.createWaveShaper();
            distortionNode.curve = makeDistortionCurve(12);
            distortionNode.oversample = '2x';

            if (ctx.createStereoPanner) {
                pannerNode = ctx.createStereoPanner();
                pannerNode.pan.value = -1;
            } else {
                pannerNode = ctx.createGain();
            }

            musicGain.connect(filterNode);
            filterNode.connect(bassBoostNode);
            bassBoostNode.connect(distortionNode);
            distortionNode.connect(pannerNode);
            pannerNode.connect(ctx.destination);

            // Generator szumu i trzasków
            const bufferSize = ctx.sampleRate * 2;
            const noiseBuffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
            const output = noiseBuffer.getChannelData(0);
            for (let i = 0; i < bufferSize; i++) {
                const crackle = Math.random() > 0.992 ? (Math.random() * 2 - 1) * 1.5 : 0;
                output[i] = (Math.random() * 2 - 1) * 0.25 + crackle;
            }
            const whiteNoise = ctx.createBufferSource();
            whiteNoise.buffer = noiseBuffer;
            whiteNoise.loop = true;

            noiseGain = ctx.createGain();
            noiseGain.gain.value = 0;
            whiteNoise.connect(noiseGain);
            noiseGain.connect(pannerNode);
            whiteNoise.start();

            // Brum sieciowy 50 Hz
            const humOsc = ctx.createOscillator();
            humOsc.type = 'sawtooth';
            humOsc.frequency.value = 50;
            humGain = ctx.createGain();
            humGain.gain.value = 0;
            humOsc.connect(humGain);
            humGain.connect(ctx.destination);
            humOsc.start();
        }

        const melodyNotes = [329.63, 0, 392.00, 329.63, 440.00, 0, 493.88, 392.00, 329.63, 293.66, 246.94, 0, 293.66, 329.63, 392.00, 0];
        const bassNotes   = [82.41, 82.41, 98.00, 82.41, 110.00, 110.00, 123.47, 98.00];

        function playStep() {
            if (!audioCtx || !isPlaying) return;
            const now = audioCtx.currentTime;

            if (stepIndex % 2 === 0) {
                const kickOsc = audioCtx.createOscillator();
                const kickGain = audioCtx.createGain();
                kickOsc.frequency.setValueAtTime(140, now);
                kickOsc.frequency.exponentialRampToValueAtTime(42, now + 0.12);
                kickGain.gain.setValueAtTime(0.55, now);
                kickGain.gain.exponentialRampToValueAtTime(0.01, now + 0.14);
                kickOsc.connect(kickGain);
                kickGain.connect(musicGain);
                kickOsc.start(now);
                kickOsc.stop(now + 0.15);
            }

            const bFreq = bassNotes[Math.floor(stepIndex / 2) % bassNotes.length];
            const bassOsc = audioCtx.createOscillator();
            const bassG = audioCtx.createGain();
            bassOsc.type = 'sawtooth';
            bassOsc.frequency.setValueAtTime(bFreq, now);
            bassG.gain.setValueAtTime(0.25, now);
            bassG.gain.exponentialRampToValueAtTime(0.01, now + 0.17);
            bassOsc.connect(bassG);
            bassG.connect(musicGain);
            bassOsc.start(now);
            bassOsc.stop(now + 0.18);

            const mFreq = melodyNotes[stepIndex % melodyNotes.length];
            if (mFreq > 0) {
                const leadOsc = audioCtx.createOscillator();
                const leadG = audioCtx.createGain();
                leadOsc.type = 'square';
                leadOsc.frequency.setValueAtTime(mFreq, now);
                leadG.gain.setValueAtTime(0.16, now);
                leadG.gain.exponentialRampToValueAtTime(0.01, now + 0.15);
                leadOsc.connect(leadG);
                leadG.connect(musicGain);
                leadOsc.start(now);
                leadOsc.stop(now + 0.16);
            }

            stepIndex++;
        }

        function updateCablePhysics(val) {
            const v = parseInt(val, 10);
            const deg = Math.round((v - 50) * 1.1);
            cableAngleVal.textContent = v;
            cableDegVal.textContent = deg;

            const visualAngle = (v - 50) * 0.55;
            jackPlugGroup.style.transform = `rotate(${visualAngle}deg)`;
            const bendY = 60 + (v - 50) * 0.9;
            jackCablePath.setAttribute('d', `M 108 60 Q 138 ${bendY}, 168 ${bendY + 15}`);

            let statusMsg = '';
            let boxBorder = 'border-neutral-700';
