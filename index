        let audioCtx = null;

        function ensureAudioCtx() {
            const AudioContextClass = window.AudioContext || window.webkitAudioContext;
            if (!audioCtx) {
                audioCtx = new AudioContextClass();
            }
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
            return audioCtx;
        }

        function toggleMobileNav() {
            document.getElementById('mobile-nav').classList.toggle('hidden');
        }

        /* =====================================================================
           1. GENERATOR GRAFIKI MEMA „SOCHAFKI” NA CANVAS (BEZ ZEWNĘTRZNYCH OBRAZKÓW)
           ===================================================================== */
        const memeCanvas = document.getElementById('sochafki-meme-canvas');
        const memeCtx = memeCanvas.getContext('2d');
        let extraClickFry = 0;

        function drawSochafkiMeme(fryPercent) {
            const effectiveFry = Math.min(100, fryPercent + extraClickFry);
            const scale = Math.max(0.22, 1 - (effectiveFry / 100) * 0.72);
            const w = Math.floor(420 * scale);
            const h = Math.floor(460 * scale);

            memeCanvas.width = w;
            memeCanvas.height = h;

            const ctx = memeCtx;
            ctx.save();
            ctx.scale(scale, scale);

            // 1. Białe tło górnego paska mema
            ctx.fillStyle = '#ffffff';
            ctx.fillRect(0, 0, 420, 96);

            // Napis „Sochafki”
            ctx.fillStyle = '#080808';
            ctx.font = '900 44px "Inter", Arial, sans-serif';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText('Sochafki', 210, 50);

            if (effectiveFry > 20) {
                ctx.fillStyle = 'rgba(0, 0, 0, 0.12)';
                for (let i = 0; i < 24; i++) {
                    const ax = 105 + Math.random() * 210;
                    const ay = 20 + Math.random() * 55;
                    ctx.fillRect(ax, ay, 4, 4);
                }
            }

            // 2. Jaskrawocyjanowe tło mema (#00ffff)
            ctx.fillStyle = '#00ffff';
            ctx.fillRect(0, 96, 420, 364);

            // Ciemny cień w lewym górnym rogu
            ctx.fillStyle = '#050505';
            ctx.beginPath();
            ctx.moveTo(0, 120);
            ctx.lineTo(190, 96);
            ctx.lineTo(230, 118);
            ctx.lineTo(0, 185);
            ctx.closePath();
            ctx.fill();

            ctx.fillStyle = '#cc5500';
            ctx.fillRect(0, 96, 80, 12);
            ctx.fillRect(150, 96, 65, 15);

            // 3. Pałąk słuchawek
            ctx.save();
            ctx.strokeStyle = '#050505';
            ctx.lineWidth = 34;
            ctx.beginPath();
            ctx.arc(205, 275, 155, Math.PI * 0.28, Math.PI * 1.25);
            ctx.stroke();

            ctx.strokeStyle = '#ffffff';
            ctx.lineWidth = 14;
            ctx.beginPath();
            ctx.arc(205, 275, 162, Math.PI * 0.55, Math.PI * 0.92);
            ctx.stroke();

            ctx.strokeStyle = '#d9480f';
            ctx.lineWidth = 6;
            ctx.beginPath();
            ctx.arc(205, 275, 154, Math.PI * 0.58, Math.PI * 0.78);
            ctx.stroke();
            ctx.restore();

            // 4. Chaotyczna plątanina kabli
            const cables = [
                { cp1x: 160, cp1y: 320, cp2x: 240, cp2y: 380, ex: 340, ey: 320, color: '#000000', w: 9 },
                { cp1x: 190, cp1y: 350, cp2x: 290, cp2y: 310, ex: 370, ey: 390, color: '#111111', w: 8 },
                { cp1x: 175, cp1y: 290, cp2x: 250, cp2y: 410, ex: 310, ey: 440, color: '#ffffff', w: 5 },
                { cp1x: 210, cp1y: 300, cp2x: 150, cp2y: 390, ex: 350, ey: 360, color: '#000000', w: 7 },
                { cp1x: 240, cp1y: 260, cp2x: 330, cp2y: 410, ex: 260, ey: 455, color: '#ffffff', w: 4 },
                { cp1x: 200, cp1y: 270, cp2x: 310, cp2y: 290, ex: 395, ey: 250, color: '#000000', w: 6 }
            ];
            cables.forEach(c => {
                ctx.beginPath();
                ctx.moveTo(215, 225);
                ctx.bezierCurveTo(c.cp1x, c.cp1y, c.cp2x, c.cp2y, c.ex, c.ey);
                ctx.strokeStyle = c.color;
                ctx.lineWidth = c.w;
                ctx.lineCap = 'round';
                ctx.stroke();
            });

            ctx.fillStyle = '#000000';
            ctx.beginPath();
            ctx.moveTo(280, 460);
            ctx.lineTo(420, 320);
            ctx.lineTo(420, 460);
            ctx.closePath();
            ctx.fill();

            // 5. Lewy nausznik
            ctx.save();
            ctx.translate(185, 195);
            ctx.rotate(-0.2);
            ctx.fillStyle = '#000000';
            ctx.beginPath();
            ctx.ellipse(0, 0, 52, 58, 0, 0, Math.PI * 2);
            ctx.fill();

            const grad = ctx.createRadialGradient(-12, -10, 5, 0, 0, 50);
            grad.addColorStop(0, '#ffffff');
            grad.addColorStop(0.35, '#e86f1c');
            grad.addColorStop(0.7, '#6b2000');
            grad.addColorStop(1, '#000000');
            ctx.fillStyle = grad;
            ctx.beginPath();
            ctx.ellipse(-4, -2, 42, 48, 0, 0, Math.PI * 2);
            ctx.fill();
            ctx.restore();

            // 6. Prawy nausznik
            ctx.save();
            ctx.translate(295, 215);
            ctx.rotate(0.15);
            ctx.fillStyle = '#000000';
            ctx.beginPath();
            ctx.ellipse(14, 0, 44, 58, 0, 0, Math.PI * 2);
            ctx.fill();

            ctx.fillStyle = '#ffffff';
            ctx.beginPath();
            ctx.ellipse(-10, -2, 34, 56, 0, 0, Math.PI * 2);
            ctx.fill();

            ctx.fillStyle = '#111111';
            ctx.beginPath();
            ctx.ellipse(-18, 0, 6, 20, 0, 0, Math.PI * 2);
            ctx.fill();
            ctx.restore();

            ctx.restore();

            // 7. Algorytmiczne usmażenie pikseli
            if (effectiveFry > 10) {
                try {
                    const imgData = ctx.getImageData(0, 0, w, h);
                    const data = imgData.data;
                    const contrast = 1 + (effectiveFry / 100) * 1.9;
                    const noiseAmt = (effectiveFry / 100) * 55;

                    for (let i = 0; i < data.length; i += 4) {
                        let r = ((data[i] - 128) * contrast) + 128;
                        let g = ((data[i + 1] - 128) * contrast) + 128;
                        let b = ((data[i + 2] - 128) * contrast) + 128;

                        if (Math.random() < 0.25) {
                            const n = (Math.random() - 0.5) * noiseAmt;
                            r += n;
                            g += n;
                            b += n;
                        }

                        if (effectiveFry > 55) {
                            const step = effectiveFry > 85 ? 85 : 51;
                            r = Math.round(r / step) * step;
                            g = Math.round(g / step) * step;
                            b = Math.round(b / step) * step;
                        }

                        data[i] = Math.max(0, Math.min(255, r));
                        data[i + 1] = Math.max(0, Math.min(255, g));
                        data[i + 2] = Math.max(0, Math.min(255, b));
                    }
                    ctx.putImageData(imgData, 0, 0);
                } catch (e) {
                    console.warn('Błąd filtrowania canvas:', e);
                }
            }
        }

