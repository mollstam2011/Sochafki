<!DOCTYPE html>
<html lang="pl" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sochafki™ — Dźwięk tak czysty, że aż trzeszczy (ft. Komputer Kamila Steinbacha)</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Inter + Space Grotesk dla kontrastu premium vs meme -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;900&family=Space+Grotesk:wght@700&display=swap" rel="stylesheet">

    <style>
        :root {
            --meme-cyan: #00ffff;
            --meme-black: #050505;
            --deep-fry-level: 0;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: #050505;
            color: #ffffff;
            overflow-x: hidden;
        }

        .font-grotesk {
            font-family: 'Space Grotesk', sans-serif;
        }

        /* Główny kontener poddawany smażeniu (Deep-Fry) */
        #fry-container {
            transition: filter 0.12s ease-out, transform 0.08s linear;
            transform-origin: center top;
        }

        /* Animacja drżenia ekranu przy wysokim poziomie Deep-Fry */
        @keyframes overdriveShake {
            0% { transform: translate(0px, 0px) rotate(0deg); }
            20% { transform: translate(-2px, 1px) rotate(-0.2deg); }
            40% { transform: translate(2px, -2px) rotate(0.2deg); }
            60% { transform: translate(-2px, -1px) rotate(0deg); }
            80% { transform: translate(2px, 2px) rotate(0.15deg); }
            100% { transform: translate(0px, 0px) rotate(0deg); }
        }

        .shake-active {
            animation: overdriveShake 0.12s infinite;
        }

        /* Nakładka artefaktów JPEG / szumu */
        #jpeg-noise-overlay {
            pointer-events: none;
            position: fixed;
            inset: 0;
            z-index: 40;
            opacity: 0;
            mix-blend-mode: overlay;
            background-image: 
                repeating-linear-gradient(0deg, rgba(0,255,255,0.15) 0px, rgba(0,255,255,0.15) 1px, transparent 1px, transparent 4px),
                repeating-linear-gradient(90deg, rgba(255,0,0,0.15) 0px, rgba(255,0,0,0.15) 2px, transparent 2px, transparent 8px);
            background-size: 8px 8px;
            transition: opacity 0.2s ease;
        }

        /* Stylizacja suwaków */
        input[type="range"].cyber-slider {
            -webkit-appearance: none;
            appearance: none;
            background: #1a1a1a;
            height: 10px;
            border-radius: 999px;
            outline: none;
            border: 1px solid #00ffff;
        }

        input[type="range"].cyber-slider::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: #00ffff;
            cursor: pointer;
            border: 3px solid #000000;
            box-shadow: 0 0 12px #00ffff;
            transition: transform 0.1s;
        }

        input[type="range"].cyber-slider::-webkit-slider-thumb:hover {
            transform: scale(1.15);
        }

        input[type="range"].cyber-slider::-moz-range-thumb {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: #00ffff;
            cursor: pointer;
            border: 3px solid #000000;
            box-shadow: 0 0 12px #00ffff;
        }

        /* Pixelated canvas rendering dla autentycznego 144p */
        .pixelated {
            image-rendering: pixelated;
            image-rendering: crisp-edges;
        }

        /* Konfetti canvas */
        #confetti-canvas {
            position: fixed;
            inset: 0;
            pointer-events: none;
            z-index: 100;
        }

        /* Animacja wskaźnika VU */
        .vu-bar {
            transition: height 0.08s ease-out, background-color 0.15s;
        }

        /* --- KOMPUTER KAMILA STEINBACHA: CRT & WINDOWS XP --- */
        .crt-bezel {
            background: linear-gradient(145deg, #e5dfc9 0%, #cfc7ae 55%, #b2a88c 100%);
            box-shadow:
                inset 0 2px 4px rgba(255,255,255,0.7),
                inset 0 -6px 12px rgba(0,0,0,0.35),
                0 15px 35px rgba(0,0,0,0.7);
        }

        .crt-screen {
            position: relative;
            overflow: hidden;
            border-radius: 14px / 10px;
            box-shadow: inset 0 0 28px rgba(0, 0, 0, 0.85);
            background: #111;
        }

        /* Skanlinie CRT */
        .crt-scanlines::after {
            content: "";
            position: absolute;
            inset: 0;
            pointer-events: none;
            background: repeating-linear-gradient(
                0deg,
                rgba(0, 0, 0, 0.18) 0px,
                rgba(0, 0, 0, 0.18) 1px,
                transparent 1px,
                transparent 3px
            );
            z-index: 20;
        }

        /* Klasyczna tapeta Windows XP (Bliss parodia) */
        .xp-wallpaper {
            background:
                radial-gradient(ellipse at 50% 108%, #4da829 0%, #3b8d1d 42%, transparent 43%),
                radial-gradient(ellipse at 18% 98%, #63bf34 0%, #449b21 38%, transparent 39%),
                linear-gradient(180deg, #2b72d6 0%, #6cb2f7 52%, #a8d8ff 72%, #3a8b1d 73%);
        }

        /* Animacja wyłączania CRT po kopnięciu listwy */
        @keyframes crtPowerOff {
            0%   { transform: scale(1, 1); filter: brightness(1); opacity: 1; }
            35%  { transform: scale(1.05, 0.015); filter: brightness(4); opacity: 1; }
            70%  { transform: scale(0.03, 0.015); filter: brightness(6); opacity: 1; }
            100% { transform: scale(0, 0); filter: brightness(0); opacity: 0; }
        }

        .crt-turning-off {
            animation: crtPowerOff 0.52s cubic-bezier(0.22, 1, 0.36, 1) forwards;
        }

        /* Animacja błogosławieństwa znakiem krzyża */
        @keyframes blessingGlow {
            0%   { opacity: 0; transform: scale(0.6) translateY(10px); }
            25%  { opacity: 1; transform: scale(1.15) translateY(0); }
            75%  { opacity: 1; transform: scale(1.0) translateY(-6px); }
            100% { opacity: 0; transform: scale(1.2) translateY(-18px); }
        }

        .blessing-anim {
            animation: blessingGlow 1.5s ease-out forwards;
        }

        /* Animacja wibracji obudowy PC przy 3 FPS */
        @keyframes pcRattle {
            0%, 100% { transform: translate(0, 0); }
            25% { transform: translate(-1.5px, 1px); }
            50% { transform: translate(1.5px, -1px); }
            75% { transform: translate(-1px, -1.5px); }
        }

        .pc-rattling {
            animation: pcRattle 0.07s infinite;
        }

        /* Migająca dioda dysku HDD */
        @keyframes hddBlink {
            0%, 100% { opacity: 0.25; }
            30% { opacity: 1; box-shadow: 0 0 8px #ef4444; }
            65% { opacity: 0.4; }
            80% { opacity: 1; box-shadow: 0 0 10px #ef4444; }
        }

        .hdd-busy {
            animation: hddBlink 0.28s infinite;
        }

        /* Akordeon FAQ */
        .faq-content {
            transition: max-height 0.28s ease, opacity 0.25s ease;
        }
    </style>
</head>
<body class="bg-black text-white selection:bg-[#00ffff] selection:text-black">

    <!-- Ukryte filtry SVG do efektu ostrej posteryzacji / deep-fry -->
    <svg class="hidden" aria-hidden="true">
        <defs>
            <filter id="deep-fry-svg-filter">
                <feComponentTransfer>
                    <feFuncR type="discrete" tableValues="0 0.25 0.5 0.75 1"/>
                    <feFuncG type="discrete" tableValues="0 0.25 0.5 0.75 1"/>
                    <feFuncB type="discrete" tableValues="0 0.25 0.5 0.75 1"/>
                </feComponentTransfer>
                <feConvolveMatrix order="3" kernelMatrix="0 -1 0 -1 5 -1 0 -1 0" preserveAlpha="true"/>
            </filter>
        </defs>
    </svg>

    <!-- Nakładka artefaktów kompresji JPEG -->
    <div id="jpeg-noise-overlay"></div>

    <!-- Canvas na konfetti SOCHAFKI -->
    <canvas id="confetti-canvas"></canvas>

    <!-- Pływający Panel Kontrolny Deep-Fry (poza #fry-container, żeby zawsze był czytelny i klikalny) -->
    <aside id="deep-fry-panel" class="fixed bottom-4 left-1/2 -translate-x-1/2 z-50 w-[94%] max-w-xl bg-black/95 border-2 border-[#00ffff] rounded-2xl p-3.5 sm:p-4 shadow-[0_0_25px_rgba(0,255,255,0.35)] backdrop-blur-md">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
            <div class="flex items-center gap-2">
                <span class="inline-block w-2.5 h-2.5 rounded-full bg-[#00ffff] animate-pulse"></span>
                <label for="deep-fry-slider" class="text-xs sm:text-sm font-black uppercase tracking-wider text-[#00ffff]">
                    Poziom Sochafek (Kompresja JPEG)
                </label>
            </div>
            <span id="deep-fry-badge" class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-white text-black">
                0% • Zwykłe słuchawki
            </span>
        </div>
        <div class="flex items-center gap-3">
            <span class="text-xs text-neutral-400 font-bold">4K</span>
            <input type="range" id="deep-fry-slider" min="0" max="100" value="18" class="cyber-slider flex-1" aria-label="Poziom usmażenia strony">
            <span class="text-xs text-[#00ffff] font-black">144p 🔥</span>
        </div>
    </aside>

    <!-- GŁÓWNA ZAWARTOŚĆ STRONY (poddawana filtrom Deep-Fry) -->
    <div id="fry-container" class="pb-36">

        <!-- Nawigacja w stylu ekskluzywnego sklepu + biały pasek mema -->
        <header class="sticky top-0 z-30 bg-black/90 backdrop-blur-md border-b border-[#00ffff]/30">
