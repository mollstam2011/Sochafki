            } else {
                deepFryBadge.className = 'text-xs font-bold px-2.5 py-0.5 rounded-full bg-white text-black';
            }

            const contrast = 100 + level * 1.45;
            const saturate = 100 + level * 2.2;
            const blur = level > 65 ? ((level - 65) / 35) * 0.9 : 0;
            const hue = level > 85 ? (level - 85) * 0.8 : 0;

            let filterStr = `contrast(${contrast}%) saturate(${saturate}%) blur(${blur.toFixed(2)}px) hue-rotate(${hue}deg)`;
            if (level >= 88) {
                filterStr += ' url(#deep-fry-svg-filter)';
