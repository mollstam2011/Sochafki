        </section>

        <!-- SEKCJA 2: INTERAKTYWNY SYMULATOR RUCHOMEGO KABLA (WEB AUDIO API) -->
        <section id="symulator" class="py-16 sm:py-24 px-4 sm:px-6 bg-neutral-950 border-b border-neutral-800">
            <div class="max-w-4xl mx-auto">
                <div class="text-center mb-10 space-y-3">
                    <span class="text-xs font-black uppercase tracking-widest text-[#00ffff] bg-[#00ffff]/10 border border-[#00ffff]/30 px-3 py-1 rounded-full">
                        Laboratorium Akustyczne
                    </span>
                    <h2 class="text-3xl sm:text-5xl font-black tracking-tight">
                        Symulator Ruchomego Kabla™
                    </h2>
                    <p class="text-neutral-400 max-w-xl mx-auto text-sm sm:text-base">
                        Poczuj prawdziwe doświadczenie Sochafek bez wychodzenia z domu. Włącz muzykę i znajdź jedyny magiczny kąt wygięcia wtyczki Jack 3.5mm, przy którym grają obie słuchawki.
                    </p>
                </div>

                <!-- Konsola Symulatora -->
                <div class="bg-black border-2 border-[#00ffff]/60 rounded-3xl p-5 sm:p-8 shadow-[0_0_35px_rgba(0,255,255,0.15)] space-y-6">
                    
                    <!-- Górny pasek: Przycisk PLAY + Status połączenia -->
                    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pb-6 border-b border-neutral-800">
                        <div class="flex items-center gap-3 w-full sm:w-auto">
                            <button id="audio-toggle-btn" onclick="toggleAudio()" class="flex-1 sm:flex-none px-6 py-3.5 bg-[#00ffff] hover:bg-white text-black font-black rounded-2xl transition-all active:scale-95 flex items-center justify-center gap-2 shadow-[0_0_20px_rgba(0,255,255,0.35)]">
                                <span id="audio-btn-icon">▶</span>
                                <span id="audio-btn-text">WŁĄCZ MUZYKĘ</span>
                            </button>
                            <button onclick="nudgeCable()" class="px-4 py-3.5 bg-neutral-900 hover:bg-neutral-800 border border-neutral-700 text-neutral-200 font-bold text-sm rounded-2xl transition-all active:scale-95" title="Delikatnie puknij wtyczkę">
                                👆 Puknij kabel
                            </button>
                        </div>

                        <!-- Dynamiczny status styku -->
                        <div id="cable-status-box" class="w-full sm:w-auto text-center sm:text-right px-4 py-2.5 rounded-xl bg-neutral-900 border border-neutral-700">
                            <div class="text-[10px] uppercase tracking-wider text-neutral-400 font-bold">Status wtyczki Jack 3.5mm</div>
                            <div id="cable-status-text" class="text-sm sm:text-base font-black text-red-400">
                                🔇 Cisza (Włącz muzykę)
                            </div>
                        </div>
                    </div>

                    <!-- Wizualizacja Lewa / Prawa słuchawka + Wygięta wtyczka -->
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-center">
                        <!-- Kanał LEWY -->
                        <div class="bg-neutral-900/80 border border-neutral-800 rounded-2xl p-4 flex flex-col items-center">
                            <div class="text-xs font-black uppercase tracking-wider text-neutral-400 mb-2">Lewa słuchawka (L)</div>
                            <div class="h-16 flex items-end gap-1.5" id="vu-left">
                                <div class="vu-bar w-3 bg-[#00ffff] rounded-t" style="height: 15%"></div>
                                <div class="vu-bar w-3 bg-[#00ffff] rounded-t" style="height: 25%"></div>
                                <div class="vu-bar w-3 bg-[#00ffff] rounded-t" style="height: 10%"></div>
                                <div class="vu-bar w-3 bg-[#00ffff] rounded-t" style="height: 20%"></div>
                                <div class="vu-bar w-3 bg-[#00ffff] rounded-t" style="height: 12%"></div>
                            </div>
                            <div id="left-status-label" class="text-xs font-bold text-neutral-500 mt-2">Czeka...</div>
                        </div>

                        <!-- Animowana wtyczka Jack 3.5mm SVG -->
                        <div class="flex flex-col items-center justify-center py-2">
                            <svg id="jack-svg" viewBox="0 0 180 120" class="w-44 h-28 overflow-visible">
                                <!-- Gniazdo -->
                                <rect x="10" y="45" width="32" height="30" rx="6" fill="#222" stroke="#00ffff" stroke-width="2"/>
                                <text x="26" y="64" fill="#00ffff" font-size="9" font-weight="bold" text-anchor="middle">AUX</text>
                                <!-- Metalowy bolec Jack -->
                                <g id="jack-plug-group" style="transform-origin: 42px 60px; transition: transform 0.08s ease-out;">
                                    <rect x="40" y="56" width="30" height="8" rx="2" fill="#d4d4d4"/>
                                    <rect x="52" y="56" width="3" height="8" fill="#111"/>
                                    <rect x="60" y="56" width="3" height="8" fill="#111"/>
                                    <!-- Plastikowa obudowa wtyczki -->
                                    <rect x="70" y="50" width="34" height="20" rx="4" fill="#111" stroke="#666" stroke-width="2"/>
                                    <!-- Taśma izolacyjna -->
                                    <rect x="96" y="51" width="12" height="18" fill="#00ffff" opacity="0.85"/>
                                    <!-- Wygięty kabel -->
                                    <path id="jack-cable-path" d="M 108 60 Q 140 60, 165 85" fill="none" stroke="#333" stroke-width="6" stroke-linecap="round"/>
                                </g>
                            </svg>
                            <div class="text-xs font-mono text-[#00ffff] font-bold mt-1">
                                Kąt wygięcia: <span id="cable-angle-val">32</span>% (<span id="cable-deg-val">18</span>°)
                            </div>
