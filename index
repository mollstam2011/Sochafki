                        ☰ Menu
                    </button>
                    <button onclick="openBuyModal()" class="bg-[#00ffff] hover:bg-white text-black font-black text-xs sm:text-sm px-3.5 sm:px-4 py-2 rounded-xl transition-transform active:scale-95 shadow-[0_0_15px_rgba(0,255,255,0.4)] shrink-0">
                        KUP (4,99 zł)
                    </button>
                </div>
            </div>

            <!-- Mobilne menu rozwijane -->
            <div id="mobile-nav" class="hidden lg:hidden border-t border-neutral-800 bg-black/95 px-4 py-3">
                <div class="flex flex-wrap gap-2 text-xs font-bold">
                    <a href="#symulator" onclick="toggleMobileNav()" class="px-3 py-2 rounded-xl bg-neutral-900 text-neutral-200 hover:text-[#00ffff]">🎧 Symulator</a>
                    <a href="#steinbach" onclick="toggleMobileNav()" class="px-3 py-2 rounded-xl bg-[#00ffff]/15 border border-[#00ffff]/40 text-[#00ffff]">🖥️ Komputer Steinbacha</a>
                    <a href="#rozplatywanie" onclick="toggleMobileNav()" class="px-3 py-2 rounded-xl bg-neutral-900 text-neutral-200 hover:text-[#00ffff]">🧶 Rozplątywanie</a>
                    <a href="#soundboard" onclick="toggleMobileNav()" class="px-3 py-2 rounded-xl bg-neutral-900 text-neutral-200 hover:text-[#00ffff]">🔊 Soundboard</a>
                    <a href="#specyfikacja" onclick="toggleMobileNav()" class="px-3 py-2 rounded-xl bg-neutral-900 text-neutral-200 hover:text-[#00ffff]">📋 Specyfikacja</a>
                    <a href="#opinie" onclick="toggleMobileNav()" class="px-3 py-2 rounded-xl bg-neutral-900 text-neutral-200 hover:text-[#00ffff]">⭐ Opinie</a>
                    <a href="#faq" onclick="toggleMobileNav()" class="px-3 py-2 rounded-xl bg-neutral-900 text-neutral-200 hover:text-[#00ffff]">❓ FAQ</a>
                </div>
            </div>
        </header>

        <!-- SEKCJA HERO -->
        <section class="relative overflow-hidden pt-10 pb-16 sm:pt-16 sm:pb-24 px-4 sm:px-6 border-b border-neutral-800">
            <!-- Subtelna cyjanowa poświata w tle -->
            <div class="absolute top-10 left-1/2 -translate-x-1/2 w-[500px] h-[500px] bg-[#00ffff]/15 rounded-full blur-[120px] pointer-events-none"></div>

            <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-12 items-center relative z-10">
                <!-- Lewa kolumna: Tekst sprzedażowy (parodia Apple/Audiofilii) -->
                <div class="text-center lg:text-left space-y-6">
                    <div class="inline-flex items-center gap-2 bg-neutral-900 border border-[#00ffff]/40 rounded-full px-3.5 py-1.5 text-xs font-bold text-[#00ffff]">
                        <span>⚡</span>
                        <span>NOWA GENERACJA DŹWIĘKU MONO 144p</span>
                    </div>

                    <h1 class="text-5xl sm:text-7xl font-black tracking-tighter leading-none">
                        <span class="bg-white text-black px-3 py-1 rounded-xl inline-block mb-2 shadow-[6px_6px_0px_#00ffff]">Sochafki™</span>
                        <span class="block text-2xl sm:text-3xl font-bold text-neutral-300 mt-3 tracking-normal">
