                <nav class="hidden lg:flex items-center gap-5 text-xs xl:text-sm font-semibold text-neutral-300">
                    <a href="#symulator" class="hover:text-[#00ffff] transition-colors">Symulator</a>
                    <a href="#steinbach" class="hover:text-[#00ffff] transition-colors text-[#00ffff] font-bold">Komputer Steinbacha</a>
