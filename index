        function applyDeepFry(val) {
            const level = parseInt(val, 10);

            let label = 'Zwykłe słuchawki';
            if (level >= 15 && level < 40) label = 'Lekki JPEG z 2009';
            else if (level >= 40 && level < 70) label = 'Smażenie na głębokim oleju';
            else if (level >= 70 && level < 95) label = 'Bazar 240p Przester';
            else if (level >= 95) label = 'SOCHAFKI 144p OVERDRIVE 🔥';

            deepFryBadge.textContent = `${level}% • ${label}`;

            if (level >= 90) {
