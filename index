                <a href="#" class="flex items-center gap-2 group shrink-0">
                    <span class="bg-white text-black font-black px-2.5 py-0.5 rounded-md text-base sm:text-lg tracking-tight group-hover:bg-[#00ffff] transition-colors">
                        Sochafki™
                    </span>
                    <span class="hidden xl:inline-block text-[11px] font-bold uppercase tracking-widest text-[#00ffff] border border-[#00ffff]/50 px-2 py-0.5 rounded-full">
                        Seria Bazar Pro
                    </span>
