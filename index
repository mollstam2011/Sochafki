        /* =====================================================================
           6. BAZAROWY SOUNDBOARD SOCHAFEK (WEB AUDIO API)
           ===================================================================== */
        function playSoundboard(type) {
            const ctx = ensureAudioCtx();
            const now = ctx.currentTime;
            const status = document.getElementById('soundboard-status');

            if (type === 'gsm') {
                // Klasyczne zakłócenia GSM: ty-ty-ty-ty-bzzzt! (pulsacja ~217 Hz w rytmie TDMA)
                status.textContent = '📱 Odtwarzanie: Zakłócenia GSM (zaraz przyjdzie SMS z sieci Plus!)';
                const bursts = [0, 0.14, 0.28, 0.42, 0.62, 0.76, 0.90];
                bursts.forEach((offset, i) => {
                    const dur = i === 3 || i === 6 ? 0.11 : 0.08;
                    const osc = ctx.createOscillator();
                    const g = ctx.createGain();
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(217, now + offset);
                    g.gain.setValueAtTime(0.09, now + offset);
                    g.gain.exponentialRampToValueAtTime(0.001, now + offset + dur);
                    osc.connect(g);
                    g.connect(ctx.destination);
                    osc.start(now + offset);
                    osc.stop(now + offset + dur + 0.02);
                });
            } else if (type === 'feedback') {
                // Krótki, bezpieczny i cichy pisk sprzężenia 3kHz
                status.textContent = '🎤 Odtwarzanie: Sprzężenie mikrofonu z sali informatycznej (ciche, bezpieczne!)';
                const osc = ctx.createOscillator();
                const g = ctx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(2850, now);
                osc.frequency.linearRampToValueAtTime(3050, now + 0.6);
                g.gain.setValueAtTime(0.001, now);
                g.gain.linearRampToValueAtTime(0.04, now + 0.15);
                g.gain.exponentialRampToValueAtTime(0.001, now + 0.85);
                osc.connect(g);
                g.connect(ctx.destination);
                osc.start(now);
                osc.stop(now + 0.9);
            } else if (type === 'hum') {
                // Wyciągnięty Jack: soczysty brum 50Hz + 100Hz
                status.textContent = '🔌 Odtwarzanie: Wyciągnięty Jack dotykający kaloryfera (BRUM 50Hz)';
                [50, 100, 150].forEach((freq, idx) => {
                    const osc = ctx.createOscillator();
                    const g = ctx.createGain();
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(freq, now);
                    g.gain.setValueAtTime(0.08 / (idx + 1), now);
                    g.gain.setTargetAtTime(0.001, now + 0.85, 0.1);
                    osc.connect(g);
                    g.connect(ctx.destination);
                    osc.start(now);
                    osc.stop(now + 1.15);
                });
            } else if (type === 'pcstart') {
                // Start Komputera Steinbacha: BIOS Beep + szum dysku HDD + rozpędzający się wiatrak
                status.textContent = '🖥️ Odtwarzanie: Start Komputera Steinbacha (BIOS Beep + HDD + Wiatrak)';
                // 1. BIOS Beep
                const beep = ctx.createOscillator();
                const beepG = ctx.createGain();
                beep.type = 'square';
                beep.frequency.setValueAtTime(1000, now + 0.08);
                beepG.gain.setValueAtTime(0.07, now + 0.08);
                beepG.gain.setValueAtTime(0.001, now + 0.24);
                beep.connect(beepG);
                beepG.connect(ctx.destination);
                beep.start(now + 0.08);
                beep.stop(now + 0.26);

                // 2. Rozpędzający się wiatrak + mielenie dysku HDD
                const bufSize = ctx.sampleRate * 1.4;
                const buf = ctx.createBuffer(1, bufSize, ctx.sampleRate);
                const ch = buf.getChannelData(0);
                for (let i = 0; i < bufSize; i++) {
                    const hddClick = (i % 2400 < 90) ? (Math.random() * 0.9) : 0;
                    ch[i] = (Math.random() * 2 - 1) * 0.4 + hddClick;
                }
                const src = ctx.createBufferSource();
                src.buffer = buf;

                const filt = ctx.createBiquadFilter();
                filt.type = 'bandpass';
                filt.frequency.setValueAtTime(180, now + 0.2);
                filt.frequency.exponentialRampToValueAtTime(650, now + 1.3);

                const g = ctx.createGain();
                g.gain.setValueAtTime(0.01, now + 0.2);
                g.gain.linearRampToValueAtTime(0.11, now + 0.6);
                g.gain.exponentialRampToValueAtTime(0.001, now + 1.55);

                src.connect(filt);
                filt.connect(g);
                g.connect(ctx.destination);
                src.start(now + 0.2);
            }
        }

