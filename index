                textColor = 'text-amber-400';
                boxBorder = 'border-amber-400/60';
                leftLbl = 'Trzeszczy (MONO)';
                rightLbl = 'Cisza';
                targetPan = -1;
                targetMusicVol = 0.22;
                targetNoiseVol = 0.12;
                targetFilterFreq = 1100;
                targetDistort = 35;
            } else if (v >= 50 && v < 68) {
                statusMsg = '🪣 Prawa gra jak z wiadra';
                textColor = 'text-orange-400';
                boxBorder = 'border-orange-400/60';
                leftLbl = 'Cisza';
                rightLbl = 'Jak ze studni';
                targetPan = 1;
                targetMusicVol = 0.20;
                targetNoiseVol = 0.10;
                targetFilterFreq = 750;
                targetDistort = 25;
            } else if (v >= 68 && v <= 74) {
                statusMsg = '🔥 IDEALNIE, NIE RUSZAJ SIĘ! (STEREO)';
                textColor = 'text-[#00ffff]';
                boxBorder = 'border-[#00ffff] shadow-[0_0_15px_rgba(0,255,255,0.4)]';
                leftLbl = 'BASS BOOSTED! 🔥';
                rightLbl = 'BASS BOOSTED! 🔥';
                targetPan = 0;
                targetMusicVol = 0.36;
                targetNoiseVol = 0.005;
                targetFilterFreq = 9500;
                targetBassBoost = 14;
                targetDistort = 48;
            } else if (v > 74 && v < 90) {
                statusMsg = '🔉 Tylko lewa i ledwo zipie';
                textColor = 'text-yellow-400';
                boxBorder = 'border-yellow-500/50';
                leftLbl = 'Ledwo gra';
                rightLbl = 'Rozłączona';
                targetPan = -0.9;
                targetMusicVol = 0.1;
                targetNoiseVol = 0.14;
                targetFilterFreq = 600;
            } else {
                statusMsg = '📻 Zwarcie! Odbierasz szum z kosmosu';
                textColor = 'text-red-400';
                boxBorder = 'border-red-500/70';
                leftLbl = 'KRRRRRZZZZZ';
                rightLbl = 'BZZZZZZT';
                targetPan = 0;
                targetMusicVol = 0.05;
                targetNoiseVol = 0.20;
                targetHumVol = 0.06;
                targetDistort = 90;
            }

            if (isPlaying) {
                cableStatusText.textContent = statusMsg;
                cableStatusText.className = `text-sm sm:text-base font-black ${textColor}`;
                cableStatusBox.className = `w-full sm:w-auto text-center sm:text-right px-4 py-2.5 rounded-xl bg-neutral-900 border ${boxBorder} transition-all`;
                leftStatusLabel.textContent = leftLbl;
                rightStatusLabel.textContent = rightLbl;
            } else {
                cableStatusText.textContent = '🔇 Cisza (Kliknij „Włącz muzykę”)';
                cableStatusText.className = 'text-sm sm:text-base font-black text-neutral-400';
                leftStatusLabel.textContent = 'Wyłączone';
                rightStatusLabel.textContent = 'Wyłączone';
            }

            if (cableAudioInitialized && audioCtx && isPlaying) {
                const t = audioCtx.currentTime;
                if (pannerNode && pannerNode.pan) {
                    pannerNode.pan.setTargetAtTime(targetPan, t, 0.03);
                }
                musicGain.gain.setTargetAtTime(targetMusicVol, t, 0.03);
                noiseGain.gain.setTargetAtTime(targetNoiseVol, t, 0.03);
                humGain.gain.setTargetAtTime(targetHumVol, t, 0.03);
                filterNode.frequency.setTargetAtTime(targetFilterFreq, t, 0.05);
                bassBoostNode.gain.setTargetAtTime(targetBassBoost, t, 0.05);
                distortionNode.curve = makeDistortionCurve(targetDistort);
            }
        }

        function animateVU() {
            const leftBars = document.querySelectorAll('#vu-left .vu-bar');
            const rightBars = document.querySelectorAll('#vu-right .vu-bar');
            const v = parseInt(cableSlider.value, 10);

            leftBars.forEach(bar => {
                if (!isPlaying) {
                    bar.style.height = '8%';
                    bar.style.backgroundColor = '#333';
                    return;
                }
                let power = 0.1;
                if (v >= 25 && v < 50) power = 0.75;
                else if (v >= 68 && v <= 74) power = 1.0;
                else if (v > 74 && v < 90) power = 0.35;
                else if (v >= 90) power = 0.5;

                const h = Math.max(8, Math.floor(Math.random() * 95 * power));
                bar.style.height = `${h}%`;
                bar.style.backgroundColor = (v >= 68 && v <= 74) ? '#00ffff' : (power > 0.3 ? '#facc15' : '#444');
            });

            rightBars.forEach(bar => {
                if (!isPlaying) {
                    bar.style.height = '8%';
                    bar.style.backgroundColor = '#333';
                    return;
                }
                let power = 0.08;
                if (v >= 50 && v < 68) power = 0.7;
                else if (v >= 68 && v <= 74) power = 1.0;
                else if (v >= 90) power = 0.5;

                const h = Math.max(8, Math.floor(Math.random() * 95 * power));
                bar.style.height = `${h}%`;
                bar.style.backgroundColor = (v >= 68 && v <= 74) ? '#00ffff' : (power > 0.3 ? '#fb923c' : '#444');
